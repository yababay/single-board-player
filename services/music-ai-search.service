[Unit]
Description=Локальный ИИ-сервер поиска музыки (FastAPI + pgvector)
After=network.target

[Service]
Type=simple
WorkingDirectory=/media/portable/.3f-lab/_projects/single-board-player
Environment="PATH=/media/portable/.3f-lab/_projects/single-board-player/.venv/bin:/usr/local/bin:/usr/bin:/bin"

# 🌟 МАГИЯ АВТОМАТИЗАЦИИ:
# Перед запуском сервера systemd вызовет наш скрипт-загрузчик. 
# Сервер FastAPI не запустится, пока модели не будут гарантированно скачаны и проверены!
ExecStartPre=python3 scripts/bootstrap-models.py

# Основной запуск сервера
ExecStart=python3 scripts/local-search-server.py

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target

