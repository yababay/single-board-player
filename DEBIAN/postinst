#!/bin/sh
set -e

SHARE_DIR="/usr/share/single-board-player"

echo "⚙️ [Деплой]: Разворачивание изолированного виртуального окружения Python..."
cd "$SHARE_DIR"

# Пересоздаем .venv, если папка пуста
if [ ! -d ".venv" ]; then
    python3 -m venv .venv
fi

# 🌟 ИСПРАВЛЕНО: Точный путь к bin/pip3 и принудительный процессорный (CPU) Torch
# Чтобы не перегружать 4 ГБ ОЗУ, сначала ставим легковесный CPU Torch, а затем остальной список
echo "📦 [Деплой]: Установка базовых ИИ-зависимостей (CPU-версии)..."
.venv/bin/pip3 install torch --index-url http://download.pytorch.org/whl/cpu/

echo "📦 [Деплой]: Установка остальных пакетов из requirements.txt..."
.venv/bin/pip3 install -r requirements.txt

echo "=========================================================================="
echo "🎉 Пакет single-board-player успешно установлен!"
echo "=========================================================================="
echo "Для финального запуска системы выполните следующие шаги на Cubi вручную:"
echo "1. Создайте пользователя базы данных и саму СУБД:"
echo "   sudo -u postgres createuser -s player"
echo "   sudo -u postgres createdb -O player player"
echo "2. Подключите расширение pgvector и восстановите дамп медиатеки:"
echo "   psql -d player -U player -c 'CREATE EXTENSION IF NOT EXISTS vector;'"
echo "   psql -d player -U player -f /путь/к/вашему/player_semantic_db.sql"
echo "3. Положите ИИ-модели в каталог: $SHARE_DIR/models/"
echo "4. Создайте файл конфигурации окружения: $SHARE_DIR/.env"
echo "=========================================================================="

exit 0

