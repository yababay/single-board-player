#!/bin/sh
set -e

# Целевой пользователь нашей музыкальной системы
TARGET_USER="player"
SHARE_DIR="/usr/share/single-board-player"

echo "⚙️ [Деплой]: Шаг 1. Перевод системы в чистый консольный режим..."
systemctl set-default multi-user.target

echo "⚙️ [Деплой]: Шаг 2. Включение режима lingering (вечная работа служб без SSH) для $TARGET_USER..."
loginctl enable-linger "$TARGET_USER"

echo "⚙️ [Деплой]: Шаг 3. Запись канонической конфигурации WirePlumber (Обход блокировки logind)..."
mkdir -p /etc/wireplumber/wireplumber.conf.d
cat << 'EOF' > /etc/wireplumber/wireplumber.conf.d/99-headless-bluetooth.conf
wireplumber.profiles = {
  main = {
    monitor.bluez.seat-monitoring = disabled
  }
}
EOF

echo "⚙️ [Деплой]: Шаг 4. Настройка изоляции виртуального окружения Python..."
cd "$SHARE_DIR"
if [ ! -d ".venv" ]; then
    python3 -m venv .venv
fi

echo "📦 [Деплой]: Установка легковесного процессорного Torch (CPU)..."
.venv/bin/pip3 install torch --index-url https://pytorch.org

echo "📦 [Деплой]: Установка остальных Python-пакетов из requirements.txt..."
.venv/bin/pip3 install -r requirements.txt

# Выставляем права на системную папку скриптов
chown -R $TARGET_USER:$TARGET_USER $SHARE_DIR

echo "=========================================================================="
echo "🎉 Системная часть single-board-player успешно установлена!"
echo "=========================================================================="
echo "⚠️  РЕКОМЕНДАЦИЯ: Пожалуйста, перезагрузите сервер (sudo reboot),"
echo "   чтобы система применила консольный профиль и отключила GUI-зависимости."
echo "После перезагрузки войдите под пользователем $TARGET_USER и запустите:"
echo "   /usr/share/single-board-player/scripts/user-init-audio.sh"
echo "=========================================================================="

exit 0

